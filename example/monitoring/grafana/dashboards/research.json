{
  "uid": "research-overview",
  "title": "Mininet research overview",
  "tags": ["research", "mininet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Host CPU utilization",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"research-host\",mode=\"idle\"}[1m]))", "legendFormat": "Host CPU"}]
    },
    {
      "id": 2,
      "title": "Host memory in use",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "node_memory_MemTotal_bytes{job=\"research-host\"} - node_memory_MemAvailable_bytes{job=\"research-host\"}", "legendFormat": "Used"}]
    },
    {
      "id": 3,
      "title": "Host disk throughput",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(node_disk_read_bytes_total{job=\"research-host\"}[1m])", "legendFormat": "{{device}} read"},
        {"refId": "B", "expr": "rate(node_disk_written_bytes_total{job=\"research-host\"}[1m])", "legendFormat": "{{device}} written"}
      ]
    },
    {
      "id": 4,
      "title": "Scrape targets up",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "up", "legendFormat": "{{job}}"}]
    },
    {
      "id": 5,
      "title": "Run lifecycle and step events",
      "description": "Event JSON lines from the run directories; filename identifies the run.",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{job=\"research-events\"}"}]
    }
  ]
}
